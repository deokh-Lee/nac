<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.saltlux.nac.record.RecordMapper">

    <resultMap id="RecordResultMap" type="Record">
        <id property="id" column="id"/>
        <result property="title" column="title"/>
        <result property="description" column="description"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <sql id="BaseColumns">
        id,
        title,
        description,
        created_at,
        updated_at
    </sql>

    <select id="findAll" resultMap="RecordResultMap">
        SELECT <include refid="BaseColumns"/>
        FROM records
        ORDER BY id DESC
    </select>

    <select id="findById" parameterType="long" resultMap="RecordResultMap">
        SELECT <include refid="BaseColumns"/>
        FROM records
        WHERE id = #{id}
    </select>

    <insert id="insert" parameterType="Record" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO records (
            title,
            description,
            created_at,
            updated_at
        ) VALUES (
            #{title},
            #{description},
            NOW(),
            NOW()
        )
    </insert>

    <update id="update" parameterType="Record">
        UPDATE records
        SET
            title = #{title},
            description = #{description},
            updated_at = NOW()
        WHERE id = #{id}
    </update>

    <delete id="deleteById" parameterType="long">
        DELETE FROM records
        WHERE id = #{id}
    </delete>

</mapper>
